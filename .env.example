# Copy this file to .env (same folder) and fill in your own values. Never commit .env.

# Kimi K3 through Amazon Bedrock
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1

# Claude Sonnet 5.5 through the Anthropic API (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
# Switch to bedrock if your AWS account gets access to Sonnet 5.5 there
SONNET_PROVIDER=anthropic

# Optional: only if check_api.py reports that the default ids are wrong
# MODEL_SONNET=claude-sonnet-5-5
# MODEL_KIMI=us.moonshotai.kimi-k3   (Kimi K3 needs an inference-profile id)
